# Copy to .env and choose your own values. .env is git-ignored; never commit it.
# These only configure the throw-away staging PostGIS container in docker-compose.yml.
POSTGRES_DB=iris_staging_db
POSTGRES_USER=iris_staging
POSTGRES_PASSWORD=change-me-locally
STAGING_DB_PORT=5434

# For running the CLI on the host against that container:
# IRIS_STAGING_DATABASE_URL=postgresql+psycopg://iris_staging:change-me-locally@127.0.0.1:5434/iris_staging_db
